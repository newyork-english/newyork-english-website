{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "newyork-english-website",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "workers_dev": true,
  "routes": [
    { "pattern": "newyorkenglish.co.kr", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "newyork-english-website-db",
      "database_id": "02605a78-912c-4688-b71a-2f81a5fd6c7e",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": { "enabled": true }
}
